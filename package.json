{
  "name": "rancut",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/check-ffmpeg.cjs && node --test tests/*.test.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "electron": "35.7.5",
    "electron-builder": "26.0.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.0",
    "vite": "6.1.6"
  },
  "build": {
    "appId": "local.rancut.editor",
    "productName": "RanCut",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**",
      "electron.cjs",
      "server.mjs",
      "src/audio-filter.js",
      "package.json",
      "node_modules/**",
      "preload.cjs",
      "src/output-store.js",
      "desktop-power.cjs",
      "src/media-service.js",
      "release-config.json",
      "src/update-check.js",
      "THIRD-PARTY-NOTICES.md",
      "licenses/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RanCut-${version}-Setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RanCut",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "description": "Local video editor for creators",
  "author": "RanCut"
}
