{
  "name": "rancut",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "lucide-react": "0.468.0",
    "ffmpeg-static": "5.2.0"
  },
  "devDependencies": {
    "vite": "6.1.6",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "local.rancut.editor",
    "productName": "RanCut",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**",
      "electron.cjs",
      "server.mjs",
      "src/audio-filter.js",
      "package.json",
      "node_modules/**",
      "preload.cjs",
      "src/output-store.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RanCut-${version}-Setup.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RanCut",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "Local video editor for creators",
  "author": "RanCut"
}
